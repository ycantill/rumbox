# Copia este archivo a .env.local y completa con los datos de tu proyecto
# Supabase (Project Settings > API). La service role key es secreta: solo se
# usa en el servidor y nunca debe llevar el prefijo NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Pantalla al día (Supabase Realtime). Project Settings > API: la misma URL y
# la anon key, que es pública: con RLS sin políticas no puede leer ninguna
# tabla, solo escuchar el canal de avisos.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Avisos al celular (Web Push). Las llaves se generan con:
#   npx web-push generate-vapid-keys
# La privada es secreta y nunca lleva NEXT_PUBLIC_. VAPID_SUBJECT es un correo
# de contacto con "mailto:" adelante. Sin estas tres la app funciona sin avisos.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
