# Copia este archivo a .env.local y completa con los datos de tu proyecto
# Supabase (Project Settings > API). La service role key es secreta: solo se
# usa en el servidor y nunca debe llevar el prefijo NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Pantalla al día (Supabase Realtime). Project Settings > API: la anon key
# (o "publishable key"), que es pública: con RLS sin políticas no puede leer
# ninguna tabla, solo escuchar el canal de cambios. Usa la misma SUPABASE_URL. Sin el prefijo
# NEXT_PUBLIC_: el navegador la pide al servidor (getLiveConfig).
SUPABASE_ANON_KEY=

# Ruta por carretera (OpenRouteService, gratis: 2.000 rutas al día). La llave
# se saca creando una cuenta en https://openrouteservice.org y es secreta: sin
# el prefijo NEXT_PUBLIC_. Sin ella la app usa la línea recta entre los
# municipios.
OPENROUTESERVICE_API_KEY=
